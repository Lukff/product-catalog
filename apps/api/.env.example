# Copy to `.env` in this directory (apps/api). The API and `pnpm db:migrate` load it on
# startup; variables already set in the real environment take precedence over the file.
# The values below are the defaults that apply when a variable is unset.

# Port the API listens on (1-65535).
PORT=3000

# SQLite database file, relative to this directory (apps/api).
# The file and its directory are created on first use.
DATABASE_PATH=./data/catalog.db
